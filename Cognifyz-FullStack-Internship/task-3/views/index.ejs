<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Registration System</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>



<nav class="navbar navbar-expand-lg navbar-dark bg-success">

    <div class="container">

        <a class="navbar-brand fw-bold" href="#">

            Student Registration System

        </a>

    </div>

</nav>



<section class="hero">

    <div class="container text-center">

        <h1 class="display-4">

            Welcome Students 🎓

        </h1>

        <p class="lead">

            Register your details quickly and securely.

        </p>

    </div>

</section>



<div class="container mt-5">

<div class="row justify-content-center">

<div class="col-lg-8">

<div class="card shadow-lg p-4">

<h2 class="text-center mb-4">

Student Registration Form

</h2>

<% if(error){ %>

<div class="alert alert-danger">

<%= error %>

</div>

<% } %>

<form action="/submit" method="POST">

<div class="row">

<div class="col-md-6">

<label class="form-label">

Full Name

</label>

<input
type="text"
class="form-control"
name="fullname"
placeholder="Enter Full Name"
required>

</div>

<div class="col-md-6">

<label class="form-label">

Email

</label>

<input
type="email"
class="form-control"
name="email"
placeholder="Enter Email"
required>

</div>

</div>

<div class="row mt-3">

<div class="col-md-6">

<label class="form-label">

Phone Number

</label>

<input
type="tel"
class="form-control"
name="phone"
placeholder="Enter Phone Number"
required>

</div>

<div class="col-md-6">

<label class="form-label">

Age

</label>

<input
type="number"
class="form-control"
name="age"
placeholder="Enter Age"
required>

</div>

</div>

<div class="row mt-3">

<div class="col-md-6">

<label class="form-label">

Course

</label>

<select
class="form-select"
name="course"
required>

<option value="">Select Course</option>

<option>B.Tech</option>

<option>BCA</option>

<option>B.Com</option>

<option>MCA</option>

</select>

</div>

<div class="col-md-6">

<label class="form-label">

City

</label>

<input
type="text"
class="form-control"
name="city"
placeholder="Enter City"
required>

</div>

</div>
<div class="row mt-3">

<div class="col-md-12">

<label class="form-label">

Gender

</label>

<div class="gender-box">

<label class="gender-option">

<input
type="radio"
name="gender"
value="Male"
required>

Male

</label>

<label class="gender-option">

<input
type="radio"
name="gender"
value="Female">

Female

</label>

<label class="gender-option">

<input
type="radio"
name="gender"
value="Other">

Other

</label>

</div>

</div>

</div>

<div class="text-center mt-4">

<button
type="submit"
class="btn btn-success btn-lg">

Register Student

</button>

</div>

</form>

</div>

</div>

</div>

</div>



<div class="container mt-5 mb-5">

<h2 class="text-center mb-4">

Registered Students

</h2>

<div class="row">

<% students.forEach(student => { %>

<div class="col-md-6 col-lg-4 mb-4">

<div class="card student-card shadow">

<div class="card-body">

<h5 class="card-title">

<%= student.fullname %>

</h5>

<p>

<strong>Email:</strong>

<%= student.email %>

</p>

<p>

<strong>Phone:</strong>

<%= student.phone %>

</p>

<p>

<strong>Age:</strong>

<%= student.age %>

</p>

<p>

<strong>Course:</strong>

<%= student.course %>

</p>

<p>

<strong>City:</strong>

<%= student.city %>

</p>

<p>

<strong>Gender:</strong>

<%= student.gender %>

</p>

</div>

</div>

</div>

<% }) %>

</div>

</div>



<footer class="bg-dark text-white text-center p-3">

<p class="mb-0">

© 2026 Student Registration System | Developed for Cognifyz Internship

</p>

</footer>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>