<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light">

    <!-- Navbar -->

    <nav class="navbar navbar-dark bg-success">

        <div class="container">

            <a class="navbar-brand fw-bold" href="#">
                Student Authentication System
            </a>

            <a href="/logout" class="btn btn-light">
                Logout
            </a>

        </div>

    </nav>



    <div class="container mt-5">

        <div class="card shadow p-5">

            <h2 class="text-success text-center mb-3">
                Welcome, <%= user.fullname %> 🎉
            </h2>

            <p class="text-center">
                You have successfully logged in.
            </p>

            <hr>

            <h4>User Details</h4>

            <table class="table table-bordered mt-3">

                <tr>
                    <th>Full Name</th>
                    <td><%= user.fullname %></td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td><%= user.email %></td>
                </tr>

                <tr>
                    <th>Account Created</th>
                    <td><%= new Date(user.createdAt).toDateString() %></td>
                </tr>

            </table>



            <hr>

            <h4 class="text-primary">
                Nationality Predictor
            </h4>

            <p>
                Enter any first name to predict the most likely nationality.
            </p>

            <form action="/predict" method="POST">

                <div class="row">

                    <div class="col-md-9">

                        <input
                            type="text"
                            name="name"
                            class="form-control"
                            placeholder="Enter First Name"
                            required>

                    </div>

                    <div class="col-md-3">

                        <button
                            class="btn btn-success w-100">

                            Predict

                        </button>

                    </div>

                </div>

            </form>



            <% if(error){ %>

                <div class="alert alert-danger mt-4">

                    <%= error %>

                </div>

            <% } %>



            <% if(prediction){ %>

                <div class="card mt-4">

                    <div class="card-header bg-success text-white">

                        Prediction Result

                    </div>

                    <div class="card-body">

                        <h5>

                            Name :

                            <strong>

                                <%= prediction.name %>

                            </strong>

                        </h5>

                        <table class="table table-bordered mt-3">

                            <thead>

                                <tr>

                                    <th>Country Code</th>

                                    <th>Probability</th>

                                </tr>

                            </thead>

                            <tbody>

                                <% prediction.country.forEach(country=>{ %>

                                    <tr>

                                        <td>

                                            <%= country.country_id %>

                                        </td>

                                        <td>

                                            <%= (country.probability * 100).toFixed(2) %> %

                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                </div>

            <% } %>



            <div class="text-center">

                <a href="/logout" class="btn btn-danger mt-4">

                    Logout

                </a>

            </div>

        </div>

    </div>

</body>

</html>